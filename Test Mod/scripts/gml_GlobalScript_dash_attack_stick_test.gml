function dash_attack_stick()
{
    var run = true;
    var prevPhase = attack_phase;
    var prevFrame = attack_frame;

    if (argument_count > 0)
    {
        anim_sprite = spr_stick_dash_attack;
        var _phase = argument[0];

        if (_phase == UnknownEnum.Value_m1)
        {
            prevPhase = -1;
            attack_phase = 0;
        }
        else
        {
            prevPhase = -1;
            attack_phase = _phase;
        }
    }
    else
    {
        attack_frame = max(--attack_frame, 0);

        if (attack_frame == 0)
        {
            prevPhase = -1;

            switch (attack_phase)
            {
                case 0:
                    attack_phase++;
                    break;

                case 1:
                    attack_phase++;
                    break;

                case 2:
                    attack_stop(UnknownEnum.Value_1);
                    run = false;
                    break;

            }
        }
    }

    friction_gravity(ground_friction, grav, max_fall_speed);

    if (run && cancel_air_check())
        run = false;

    while (run && (prevPhase != attack_phase || prevFrame != attack_frame))
    {
        if (prevPhase != attack_phase)
        {
            switch (attack_phase)
            {
                case 0:
                    attack_frame = 11;
                    break;

                case 1:
                    attack_frame = 10;
                    break;

                case 2:
                    attack_frame = 15;
                    break;

            }
        }

        prevPhase = attack_phase;
        prevFrame = attack_frame;

        switch (attack_phase)
        {
            case 0:
                switch (attack_frame)
                {
                    case 11:
                        anim_frame = 0;
                        break;

                    case 9:
                        anim_frame = 1;
                        anim_frame = 1
                        break;

                    case 5:
                        anim_frame = 2;
                        anim_frame = 2
                        break;

                    case 2:
                        anim_frame = 3;
                        anim_frame = 3
                        break;

                    case 0:
                        anim_frame = 4;
                        var hitbox1 = hitbox_create_melee(12, 6, 1.1, 0.5, 4, 0, 0, 10, 65, 2, UnknownEnum.Value_m2, 0);
                        hitbox1.hit_vfx_style = UnknownEnum.Value_2;
                        hitbox1.hit_sfx = 143;
                        speed_set(6 * facing, 0, false, false);
                        attack_phase++;
                        attack_frame = 10;
                        _hitbox.hit_sfx = 143;
                        _hitbox.knockback_state = UnknownEnum.Value_27;
                        break;

                }

                friction_gravity(ground_friction, grav, max_fall_speed);
                break;

            case 1:
                switch (attack_frame)
                {
                    case 8:
                        anim_frame = 5;
                        var hitbox1 = hitbox_create_melee(12, 6, 1.1, 0.5, 4, 0, 0, 6, 70, 8, UnknownEnum.Value_m2, 0);
                        hitbox1.hit_vfx_style = UnknownEnum.Value_1;
                        hitbox1.hit_sfx = 5;
                        _hitbox.hit_sfx = 5;
                        break;

                    case 4:
                        anim_frame = 6;
                        anim_frame = 6
                        break;

                    case 0:
                        anim_frame = 7;
                        attack_phase++;
                        attack_frame = attack_connected() ? 15 : 22;
                        break;

                }

                break;

            case 2:
                switch (attack_frame)
                {
                    case 0:
                        anim_frame = 0;
                        attack_stop(UnknownEnum.Value_0);
                        run = false;
                        break;

                }

                friction_gravity(ground_friction, grav, max_fall_speed);
                if (attack_frame <= 15)
                anim_frame = 8;
                if (attack_frame <= 10)
                anim_frame = 9;
                if (attack_frame <= 5)
                anim_frame = 10;
                break;

        }
    }
    move_grounded();
}

enum UnknownEnum
{
    Value_m2 = -2,
    Value_m1,
    Value_1 = 1,
    Value_4 = 4
}
